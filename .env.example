# ============================================================
# AI Research Assistant - Environment Variables
# Copy this file to .env in the /server folder and fill in values.
# NEVER commit the real .env file.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# OPTION A (recommended, shared by the whole team): a hosted PostgreSQL such as
# Supabase or Neon. Paste ONE connection string here. For Supabase use the
# "Session pooler" string (Connect button -> Session pooler). See TEAM_SETUP.md.
# When DATABASE_URL is set, the PG* values below are ignored.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# OPTION B (local PostgreSQL on your own computer): leave DATABASE_URL empty or
# delete the line above, and fill these in instead.
#PGHOST=localhost
#PGPORT=5432
#PGDATABASE=ai_research_assistant
#PGUSER=postgres
#PGPASSWORD=postgres

# Optional database tuning:
#   DB_SSL=on|off|strict   (default: automatic - TLS for hosted DBs, off for localhost)
#   DB_POOL_MAX=5          (connections per machine; keep small on free hosted tiers)

# --- Auth ---
# Long random secret used to sign session tokens (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=replace_with_a_long_random_string
AUTH_TOKEN_EXPIRY_HOURS=168

# --- AI Provider (configurable / modular — see server/services/aiService.js) ---
# Primary provider as of Pass 3: OpenRouter, using the OpenAI-compatible
# chat completions format. The API key stays server-side and is never sent
# to the frontend.
AI_PROVIDER=openrouter
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=replace_with_your_openrouter_api_key
AI_MODEL=openrouter/free

# To use Anthropic's Claude API instead, set:
#   AI_PROVIDER=anthropic
#   AI_API_URL=https://api.anthropic.com/v1/messages
#   AI_API_KEY=your_anthropic_key
#   AI_MODEL=claude-sonnet-4-5
AI_API_VERSION=2023-06-01

# --- OpenAlex ---
# OpenAlex is free and keyless. Providing an email is recommended by
# OpenAlex for the 'polite pool' (higher rate limits), not required.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_CONTACT_EMAIL=your_email@example.com

# --- Pass 10: reliability + caching (all optional, sensible defaults) ---
# How long to wait for the AI provider (free models can be slow).
AI_TIMEOUT_MS=90000
# Automatic retries on 429 / 5xx / network errors.
AI_MAX_RETRIES=2
# Cache of structured AI answers (memory + PostgreSQL). Set to "off" to disable.
AI_CACHE=on
# How long a cached AI answer stays valid.
AI_CACHE_TTL_HOURS=168
# CLIENT_ORIGIN may list several origins, comma-separated. In development any
# localhost/127.0.0.1 port is accepted automatically.
# Frontend (client/.env, optional): VITE_API_BASE=https://your-api.example.com/api
#   VITE_API_PORT=5000   (backend port the Vite dev proxy forwards /api to)

# Maximum completion budget for one structured response. This is a safety cap,
# not a guarantee that every model supports this many output tokens.
AI_MAX_OUTPUT_TOKENS=6000
# Token multiplier applied to the next attempt after truncation/invalid JSON.
AI_RETRY_TOKEN_MULTIPLIER=1.6
